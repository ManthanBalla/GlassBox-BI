# GlassBox-BI Environment Configuration Template
# Copy this file to .env and adjust the values for your local development.

# Application Settings
APP_NAME=GlassBox-BI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Database Configuration (Optional for initial phases, local SQLite default)
DATABASE_URL=sqlite:///./glassbox.db

# LLM & Agent Configuration (For future agent phases)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-2.0-flash

# Cache & Storage
DATA_DIR=./data
MODEL_DIR=./models
